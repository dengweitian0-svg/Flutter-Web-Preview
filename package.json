{
  "name": "flutter-web-preview",
  "displayName": "Flutter Web Preview",
  "description": "Preview Flutter Web inside VS Code, update on Dart save, and stop when the preview closes.",
  "version": "0.1.3",
  "publisher": "wende",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dengweitian0-svg/Flutter-Web-Preview.git" },
  "engines": { "vscode": "^1.140.0" },
  "categories": ["Other"],
  "keywords": ["flutter", "dart", "web", "preview"],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Preview runs the workspace's Flutter application." },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onLanguage:dart", "workspaceContains:**/pubspec.yaml"],
  "contributes": {
    "debuggers": [{ "type": "flutter-web-preview", "label": "Flutter Web Preview Logs", "languages": [], "configurationAttributes": { "launch": { "properties": {}, "required": [] } } }],
    "commands": [
      { "command": "flutterWebPreview.run", "title": "Run Web Preview", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.stop", "title": "Stop Web Preview", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.restart", "title": "Restart Web Preview", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.reload", "title": "Reload Web Preview", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.openBrowser", "title": "Open Preview Browser", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.reloadBrowser", "title": "Reload Preview Browser", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.showOutput", "title": "Show Output", "category": "Flutter Web Preview" },
      { "command": "flutterWebPreview.showDebugConsole", "title": "Show Debug Console", "category": "Flutter Web Preview" }
    ],
    "configuration": {
      "title": "Flutter Web Preview",
      "properties": {
        "flutterWebPreview.flutterSdkPath": { "type": "string", "default": "", "scope": "machine-overridable", "description": "Flutter SDK root. Falls back to dart.flutterSdkPath and PATH." },
        "flutterWebPreview.entrypoint": { "type": "string", "default": "lib/main.dart", "scope": "resource", "description": "Default entrypoint relative to the Flutter project." },
        "flutterWebPreview.port": { "type": "integer", "default": 7357, "minimum": 1024, "maximum": 65535, "scope": "resource", "description": "Local Flutter Web server port. Changes apply on next start." },
        "flutterWebPreview.reloadOnSave": { "type": "boolean", "default": true, "scope": "resource", "description": "Automatically recompile and refresh on Dart save. Page state may reset." },
        "flutterWebPreview.reloadOnAutoSave": { "type": "boolean", "default": false, "scope": "resource", "description": "Also recompile and refresh when VS Code automatically saves a Dart file (after a delay or on focus change). Requires reloadOnSave. Disabled by default; manual saves still update the preview." },
        "flutterWebPreview.reloadDelay": { "type": "integer", "default": 300, "minimum": 0, "maximum": 60000, "scope": "resource", "description": "Debounce delay in milliseconds." },
        "flutterWebPreview.startupTimeout": { "type": "integer", "default": 180000, "minimum": 1000, "maximum": 3600000, "scope": "resource", "description": "Flutter startup timeout in milliseconds." },
        "flutterWebPreview.reloadTimeout": { "type": "integer", "default": 30000, "minimum": 1000, "maximum": 3600000, "scope": "resource", "description": "Compilation timeout in milliseconds." },
        "flutterWebPreview.showCodeLens": { "type": "boolean", "default": true, "scope": "resource", "description": "Show Run Web Preview above top-level Dart main declarations." }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src test/unit test/extension scripts",
    "test": "node scripts/prepare-artifacts.mjs && vitest run",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "node scripts/prepare-artifacts.mjs && vsce package --no-dependencies --out artifacts/flutter-web-preview-0.1.3.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "esbuild": "^0.27.0",
    "vitest": "^5.0.3"
  },
  "dependencies": { "yaml": "^2.8.0" }
}
